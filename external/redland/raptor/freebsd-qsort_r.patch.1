FreeBSD 14 changed qsort_r(3) to the POSIX/glibc argument order and defines
qsort_r as a _Generic macro in <stdlib.h> that accepts both. sort_r.h's own
BSD-style declaration then expands the macro and does not compile. Use the
glibc-style interface whenever qsort_r is a macro, and parenthesise the
declarations so they are never macro-expanded. Taken from the FreeBSD port
(textproc/raptor2, files/patch-src_sort__r.h).

--- a/src/sort_r.h
+++ b/src/sort_r.h
@@ -24,11 +24,12 @@
      defined OpenBSD3_1 || defined OpenBSD3_9 || defined __OpenBSD__ || \
      defined __NetBSD__ || \
      defined __DragonFly__ || \
-     defined AMIGA)
+     defined AMIGA) && !defined(qsort_r)
 #  define _SORT_R_BSD
 #elif (defined _GNU_SOURCE || defined __gnu_hurd__ || defined __GNU__ || \
        defined __linux__ || defined __MINGW32__ || defined __GLIBC__ || \
-       defined __CYGWIN__ || defined __EMSCRIPTEN__)
+       defined __CYGWIN__ || defined __EMSCRIPTEN__) || \
+       defined(qsort_r)
 #  define _SORT_R_LINUX
 #elif (defined _WIN32 || defined _WIN64 || defined __WINDOWS__)
 #  define _SORT_R_WINDOWS
@@ -65,7 +66,7 @@
   #if defined _SORT_R_BSD
 
     /* BSD requires argument swap */
-    extern void qsort_r(void *base, size_t nel, size_t width, void *thunk,
+    extern void (qsort_r)(void *base, size_t nel, size_t width, void *thunk,
                         int (*compar)(void *_thunk, const void *_a, const void *_b));
 
     struct sort_r_data
@@ -83,7 +84,7 @@
   #elif defined _SORT_R_LINUX
 
     typedef int(* __compar_d_fn_t)(const void *, const void *, void *);
-    extern void qsort_r(void *base, size_t nel, size_t width,
+    extern void (qsort_r)(void *base, size_t nel, size_t width,
                         __compar_d_fn_t __compar, void *arg)
       __attribute__((nonnull (1, 4)));
 
